# Gradle
.gradle/
build/
# Minecraft writes its own run logs here (a headless bootstrap in a test will create
# them too) — they are never part of the mod.
logs/

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# Fabric Loom cache (inside project)
.loom-cache/
run/

# CI release staging (renamed jars for CurseForge upload)
upload/

# Secrets — never commit tokens/keys.
#
# Keep runtime tokens and configs out of git. Real key protection: set
# BLOCKPAL_API_TOKEN as an environment variable so the token never lands on disk.
# See wiki/Security.md.
*.env
.env
huggingface.env
secrets.properties
# Git config / global-excludes files dropped inside the repo. The testing HF key
# lives in the machine's ~/.config/git/ignore; a copy of that folder must NEVER be
# committed here. Ignore any .config directory at any depth (e.g. .config/git/ignore,
# builds/.config/...). Does NOT affect the source 'config' Java package, which lives
# under src/.../com/milkdromeda/blockpal/config/.
.config/
**/.config/
# Runtime config that can contain the (obfuscated) API token — never commit it.
# (Specifically the game's config/blockpal/ folder — NOT the source 'config'
# package, which is com/milkdromeda/blockpal/config/.)
config/blockpal/
run/config/
# Loose token/secret files people sometimes drop in a repo by accident.
*.token
*.secret
hf_token*
hf_tocken*
blockpal-token*

# Python bytecode from the Bedrock build/validate scripts
__pycache__/
*.pyc
