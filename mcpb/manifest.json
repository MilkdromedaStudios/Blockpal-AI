{
  "manifest_version": "0.3",
  "name": "blockpal",
  "display_name": "BlockPal",
  "version": "1.0.0",
  "description": "Connect Claude Desktop to the local BlockPal Minecraft MCP server.",
  "author": {
    "name": "Milkdromeda Studios"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MilkdromedaStudios/Blockpal-AI.git"
  },
  "documentation": "https://github.com/MilkdromedaStudios/Blockpal-AI/wiki/MCP-Server",
  "support": "https://github.com/MilkdromedaStudios/Blockpal-AI/issues",
  "server": {
    "type": "node",
    "entry_point": "server/index.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/index.js"
      ],
      "env": {
        "BLOCKPAL_ENDPOINT": "${user_config.endpoint}",
        "BLOCKPAL_TOKEN": "${user_config.token}"
      }
    }
  },
  "tools_generated": true,
  "compatibility": {
    "platforms": [
      "win32",
      "darwin"
    ],
    "runtimes": {
      "node": ">=18.0.0"
    }
  },
  "user_config": {
    "endpoint": {
      "type": "string",
      "title": "BlockPal MCP address",
      "description": "The address shown by /ai mcp in Minecraft.",
      "default": "http://localhost:8000/blockpal",
      "required": true
    },
    "token": {
      "type": "string",
      "title": "BlockPal access token",
      "description": "The token shown by /ai mcp token in Minecraft.",
      "sensitive": true,
      "required": true
    }
  }
}
